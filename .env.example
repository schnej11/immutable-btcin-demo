WIF_KEY=your_testnet_wif_key_here

# ── CyberSeal services ────────────────────────────────────────────────────────
# Shared secret between gateway and logger (never expose to agent)
LOGGER_SECRET=dev-secret-change-me

# Service ports (defaults shown)
LOGGER_PORT=3002
GATEWAY_PORT=3003
MCP_PORT=3004
LOGGER_URL=http://localhost:3002
MCP_URL=http://localhost:3004

# ── Lightning / L402 (optional — mock mode if not set) ───────────────────────
# Spin up local regtest: https://lightningpolar.com/
# LND_HOST=https://localhost:8080
# LND_MACAROON=<hex-encoded admin.macaroon>
MOCK_PAYMENT_DELAY_MS=3000
